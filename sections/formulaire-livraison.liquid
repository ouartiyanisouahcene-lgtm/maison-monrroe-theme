  window.lvUpdateBaladia = function(sid) {
    var w = document.getElementById('lv-wilaya-' + sid).value;
    var b = document.getElementById('lv-baladia-' + sid);
    b.innerHTML = '<option value="">— Sélectionnez votre commune —</option>';
    if (!w || !WILAYAS[w]) { b.disabled = true; return; }
    WILAYAS[w].forEach(function(c) {
      var o = document.createElement('option');
      o.value = c; o.textContent = c;
      b.appendChild(o);
    });
    b.disabled = false;
  };

  window.lvSubmit = function(sid, productName, productUrl, productPrice) {
    var fields = [
      { id: 'lv-prenom-' + sid, err: 'lv-e-prenom-' + sid, fn: function(v){ return v.trim().length >= 2; } },
      { id: 'lv-nom-' + sid,    err: 'lv-e-nom-' + sid,    fn: function(v){ return v.trim().length >= 2; } },
      { id: 'lv-wilaya-' + sid, err: 'lv-e-wilaya-' + sid, fn: function(v){ return v !== ''; } },
      { id: 'lv-baladia-' + sid,err: 'lv-e-baladia-' + sid,fn: function(v){ return v !== ''; } },
      { id: 'lv-taille-' + sid, err: 'lv-e-taille-' + sid, fn: function(v){ return v !== ''; } },
      { id: 'lv-couleur-' + sid,err: 'lv-e-couleur-' + sid,fn: function(v){ return v !== ''; } },
    ];
    var ok = true;
    fields.forEach(function(f) {
      var el = document.getElementById(f.id);
      var valid = f.fn(el.value);
      el.classList.toggle('lv-err', !valid);
      document.getElementById(f.err).classList.toggle('show', !valid);
      if (!valid) ok = false;
    });
    var tel = document.getElementById('lv-tel-' + sid);
    var digits = tel.value.replace(/\D/g,'');
    var telOk = digits.length === 10 && /^0[567]/.test(digits);
    tel.classList.toggle('lv-err', !telOk);
    document.getElementById('lv-e-tel-' + sid).classList.toggle('show', !telOk);
    if (!telOk) ok = false;
    if (!ok) return;

    var btn = document.getElementById('lv-btn-' + sid);
    btn.disabled = true;
    btn.textContent = 'Envoi en cours...';

    var wilaya = document.getElementById('lv-wilaya-' + sid).value;
    var payload = {
      nom:           document.getElementById('lv-nom-' + sid).value.trim(),
      prenom:        document.getElementById('lv-prenom-' + sid).value.trim(),
      wilaya:        wilaya,
      numero_wilaya: wilaya.split(' - ')[0],
      baladia:       document.getElementById('lv-baladia-' + sid).value,
      telephone:     '+213' + tel.value.trim(),
      produit:       productName,
      taille:        document.getElementById('lv-taille-' + sid).value,
      couleur:       document.getElementById('lv-couleur-' + sid).value,
      lien_produit:  productUrl,
      prix:          productPrice
    };

    var scriptUrl = document.getElementById('lv-script-url-' + sid) ? document.getElementById('lv-script-url-' + sid).value : '';
    if (scriptUrl && scriptUrl !== 'VOTRE_URL_ICI') {
      fetch(scriptUrl, { method: 'POST', mode: 'no-cors', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) }).catch(function(){});
    }

    setTimeout(function() {
      var rows = [
        ['Nom', payload.prenom + ' ' + payload.nom],
        ['Téléphone', payload.telephone],
        ['Wilaya', payload.wilaya],
        ['Commune', payload.baladia],
        ['Produit', payload.produit],
        ['Taille', payload.taille],
        ['Couleur', payload.couleur],
        ['Prix', payload.prix + ' DZD'],
      ];
      document.getElementById('lv-summary-' + sid).innerHTML = rows.map(function(r){
        return '<div class="lv-summary-row"><span>' + r[0] + '</span><span>' + r[1] + '</span></div>';
      }).join('');
      document.getElementById('lv-form-' + sid).style.display = 'none';
      document.getElementById('lv-success-' + sid).classList.add('show');
    }, 800);
  };

  document.addEventListener('DOMContentLoaded', function() {
    var tel = document.getElementById('lv-tel-{{ section.id }}');
    if (tel) tel.addEventListener('input', function(){ this.value = this.value.replace(/\D/g,''); });
  });
})();
</script>

<input type="hidden" id="lv-script-url-{{ section.id }}" value="{{ section.settings.google_script_url }}">

{% schema %}
{
  "name": "Formulaire de livraison",
  "tag": "section",
  "class": "section-livraison",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "Commander maintenant"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Sous-titre",
      "default": "Livraison dans toute l'Algérie"
    },
    {
      "type": "text",
      "id": "google_script_url",
      "label": "URL Google Apps Script",
      "info": "Collez ici l'URL de votre Google Apps Script pour enregistrer les commandes dans Google Sheets"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding haut",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bas",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Formulaire de livraison"
    }
  ]
}
{% endschema %}
